# Zoom Server-to-Server OAuth app
# (Zoom App Marketplace -> your app -> App Credentials)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Webhook secret token (Feature -> Event Subscriptions). Not used by the app yet.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Local web server port -> http://localhost:4000
PORT=4000
