# Zoom Server-to-Server OAuth app
# (Zoom App Marketplace -> your app -> App Credentials)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Webhook secret token (Feature -> Event Subscriptions). Not used by the app yet.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Gmail or Google Workspace account the CRM sends from and reads (Inbox tab, Email on leads).
# The app password comes from myaccount.google.com/apppasswords and only works with its own account's address.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Local web server port -> http://localhost:4000
PORT=4000

# Who can reach the server. 127.0.0.1 = this computer only (default); 0.0.0.0 = the office network too.
# HOST=0.0.0.0

# Where the CRM database is kept (default: data/crm.db).
# DB_FILE=data/crm.db

# Outgoing calls that end within this many seconds of being answered count as "Not connected",
# because Zoom also reports voicemail and phone menus as connected. 0 = use Zoom's result as is.
MIN_CONNECTED_SECONDS=10
